# Stack de desarrollo local — variables de configuración.
#
# Copia este archivo a `.env` para personalizar el stack:
#   cp .env.example .env
#
# Sin archivo `.env`, compose.yaml usa estos mismos valores por defecto
# (sintaxis `${VAR:-default}` inline). Todo lo que aparece aquí se puede
# cambiar sin editar compose.yaml.

# ------------------------------------------------------------------
# Imágenes (versiones confirmadas con docker pull en la implementación)
# ------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
ADMINER_IMAGE=adminer:4.17.1
# Redis Commander solo publica el tag `latest` en Docker Hub (sin tags de
# versión), así que se fija por digest. Para actualizarlo: cambia el digest
# aquí y ejecuta `docker compose pull redis-commander`.
REDIS_COMMANDER_IMAGE=rediscommander/redis-commander@sha256:19cd0c49f418779fa2822a0496c5e6516d0c792effc39ed20089e6268477e40a

# ------------------------------------------------------------------
# Puertos publicados en el host (siempre en 127.0.0.1)
# ------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
# UIs web: Adminer (Postgres) y Redis Commander (perfil tools)
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082

# ------------------------------------------------------------------
# Postgres — credenciales y base de datos inicial
# ------------------------------------------------------------------
POSTGRES_USER=devstack
POSTGRES_PASSWORD=devstack
POSTGRES_DB=devstack

# ------------------------------------------------------------------
# Redis — contraseña (requirepass)
# ------------------------------------------------------------------
REDIS_PASSWORD=devstack-redis
